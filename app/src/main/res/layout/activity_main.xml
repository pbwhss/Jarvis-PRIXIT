<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02050E"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            text="J . A . R . V . I . S"
            android:text="J . A . R . V . I . S"
            android:textColor="#00F3FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.25" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MADE BY P R I X I T"
            android:textColor="#00FF9D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.35"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/sysStatsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CORE: ONLINE  |  SPEED: ULTRA-FAST"
            android:textColor="#6B8CAE"
            android:textSize="10sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <com.prixit.jarvis.ArcReactorView
        android:id="@+id/arcReactorView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/topHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAP REACTOR OR MIC TO ACTIVATE"
        android:textColor="#00F3FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/arcReactorView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/micButton"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="⚡ SPEAK TO JARVIS"
        android:textColor="#02050E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#00F3FF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
